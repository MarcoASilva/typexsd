{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": ".",
        "noEmit": true,
        "declaration": false,
        "declarationMap": false,
        "sourceMap": false,
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "examples/**/*.ts",
        "vitest.config.mts"
    ],
    "exclude": [
        "node_modules",
        "build",
        "tests/stubs/generated/**"
    ]
}
