{
    "name": "typexsd",
    "version": "0.4.0-beta.0",
    "description": "Type-safe xml paser and builder based on xsd spec for typescript",
    "main": "build/index.js",
    "types": "build/index.d.ts",
    "bin": {
        "typexsd": "build/cli.js"
    },
    "readme": "README.md",
    "files": [
        "build"
    ],
    "scripts": {
        "build": "rm -rf build && tsc",
        "format": "prettier --write .",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:local": "vitest run --config vitest.local.config.mts"
    },
    "keywords": [
        "typed",
        "xml",
        "builder",
        "parser",
        "xsd",
        "interfaces",
        "type",
        "types",
        "typescript",
        "converter"
    ],
    "author": "Marco Silva<marco.up.bsi@gmail.com> (https://github.com/marcoasilva)",
    "license": "MIT",
    "dependencies": {
        "change-case": "^4.1.2",
        "sax": "^1.6.1",
        "typescript": "^5.9.3"
    },
    "peerDependencies": {
        "zod": "^3.23.0 || ^4.0.0"
    },
    "peerDependenciesMeta": {
        "zod": {
            "optional": true
        }
    },
    "devDependencies": {
        "@peker/prettier-config": "^1.1.1",
        "@types/node": "^22.20.5",
        "@types/sax": "^1.2.7",
        "eslint": "^8.17.0",
        "prettier": "^2.6.2",
        "vitest": "^5.1.0",
        "zod": "^3.25.76"
    },
    "engines": {
        "node": ">=18"
    }
}